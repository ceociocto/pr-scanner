{
  "name": "pr-scanner",
  "version": "0.1.0",
  "description": "AI-powered PR quality scanner for GitHub repositories",
  "type": "module",
  "bin": {
    "pr-scanner": "./dist/pr-scanner.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/pr-scanner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ bin/",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@octokit/plugin-throttling": "^10.0.0",
    "@octokit/plugin-enterprise-server": "^10.0.0",
    "@octokit/plugin-enterprise-compatibility": "^4.0.0",
    "commander": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.39.0",
    "picocolors": "^1.1.0",
    "ora": "^8.0.0",
    "papaparse": "^5.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/papaparse": "^5.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "prettier": "^3.5.0",
    "drizzle-kit": "^0.30.0"
  }
}
