{
  "name": "pr-scanner",
  "version": "0.1.0",
  "description": "AI-powered PR quality scanner for GitHub repositories",
  "type": "module",
  "bin": {
    "pr-scanner": "./dist/pr-scanner.js"
  },
  "scripts": {
    "build": "tsup && npm run dashboard:build",
    "build:backend": "tsup",
    "dashboard:dev": "vite --config vite.config.ts",
    "dashboard:build": "vite build --config vite.config.ts",
    "dashboard:check": "tsc -p web/tsconfig.json --noEmit",
    "test:web": "vitest run --config vitest.web.config.ts",
    "dev": "tsx bin/pr-scanner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ bin/",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\" \"web/**/*.{ts,tsx,css,json}\" vite.config.ts vitest.web.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\" \"web/**/*.{ts,tsx,css,json}\" vite.config.ts vitest.web.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.42",
    "@fastify/static": "^7.0.4",
    "@octokit/plugin-enterprise-compatibility": "^4.0.0",
    "@octokit/plugin-enterprise-server": "^10.0.0",
    "@octokit/plugin-throttling": "^10.0.0",
    "@octokit/rest": "^21.0.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.66",
    "better-sqlite3": "^11.0.0",
    "commander": "^13.0.0",
    "drizzle-orm": "^0.39.0",
    "fastify": "^4.29.1",
    "lucide-react": "^1.31.0",
    "ollama-ai-provider": "^1.2.0",
    "ora": "^8.0.0",
    "papaparse": "^5.5.0",
    "picocolors": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  }
}
